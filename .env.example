# Copia questo file in .env.local (in locale) oppure inserisci le variabili su Vercel
# (Project → Settings → Environment Variables). Ne basta UNA tra le chiavi qui sotto.

# --- Gratis, consigliato per iniziare ---
# Groq: https://console.groq.com → API Keys. Nessuna carta.
GROQ_API_KEY=

# Google AI Studio: https://aistudio.google.com/apikey. Nessuna carta per i modelli Flash.
# GEMINI_API_KEY=

# OpenRouter (modelli con suffisso :free): https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# --- A pagamento, qualità più alta ---
# Anthropic: https://console.anthropic.com
# ANTHROPIC_API_KEY=

# --- Qualsiasi altro endpoint compatibile OpenAI ---
# AI_API_KEY=
# AI_BASE_URL=https://esempio.com/v1

# Modello da usare al posto di quello predefinito del provider
# (Groq: openai/gpt-oss-120b · Gemini: gemini-2.5-flash-lite · Anthropic: claude-opus-5-5)
# AI_MODEL=

# Quanto testo del diario passare al modello a ogni domanda, in caratteri.
# Abbassalo (es. 4000) se il provider gratuito si lamenta dei token al minuto.
# AI_CONTEXT_CHARS=7000

# Freni gentili alle richieste (per visitatore e totali, al minuto)
# RATE_LIMIT_PER_MINUTE=10
# RATE_LIMIT_GLOBAL_PER_MINUTE=120
